# Copy values into your local shell or CI secrets. Do not commit a real token.
export SENTRY_ORG="study-box"
export SENTRY_PROJECT="study-macos"
export SENTRY_AUTH_TOKEN="replace-with-a-token-from-sentry"

# Use either ARCHIVE_PATH or DSYM_PATH when uploading.
export ARCHIVE_PATH="/path/to/StudyBoxes.xcarchive"
# export DSYM_PATH="/path/to/StudyBoxes.xcarchive/dSYMs"
